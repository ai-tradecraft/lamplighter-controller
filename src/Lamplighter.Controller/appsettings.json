{
  "Runner": {
    "RunnerId": "runner_local",
    "OrchestratorBaseUri": "http://127.0.0.1:5087",
    "PollInterval": "00:00:02",
    "LongPollWait": "00:00:30",
    "HeartbeatInterval": "00:00:10",
    "LeaseSeconds": 60,
    "RetryBackoff": "00:00:05",
    "Adapter": {
      "Kind": "opencode-cli",
      "Executable": "uv",
      "ArgumentPrefix": [
        "run",
        "lamplighter-opencode"
      ],
      "Commands": {
        "Operation": "adapter-operation",
        "ObserveRuntimes": "observe-runtimes"
      }
    }
  }
}
